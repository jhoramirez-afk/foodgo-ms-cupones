              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Lista JSON\", () => pm.expect(Array.isArray(pm.response.json())).to.eql(true));"
                ]
              }
            }
          ]
        },
